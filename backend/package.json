{
  "name": "@odan/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "user:create": "tsx scripts/create-user.ts",
    "user:recover": "tsx scripts/reset-password.ts",
    "reconcile:report": "tsx scripts/reconcile-estimates.ts report",
    "reconcile:preview": "tsx scripts/reconcile-estimates.ts preview",
    "reconcile:apply": "tsx scripts/reconcile-estimates.ts apply",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:drive": "tsx scripts/test-google-drive.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@prisma/client": "6.19.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.19.0",
    "googleapis": "^182.0.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "puppeteer": "^25.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "prisma": "6.19.0",
    "supertest": "^7.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  }
}
